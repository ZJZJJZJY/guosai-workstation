{
  "deepseek": {
    "transport": "cli",
    "kind": "dsh",
    "profile": "headless",
    "role": "data",
    "timeout": 900
  },
  "claude": {
    "transport": "cli",
    "kind": "claude",
    "model": "opus",
    "role": "orchestrator",
    "timeout": 900
  },
  "gpt": {
    "transport": "cli",
    "kind": "codex",
    "model": "gpt-5.6-sol",
    "fallback_models": ["gpt-5.6", "gpt-5.6-codex"],
    "role": "reviewer",
    "timeout": 900
  }
}
